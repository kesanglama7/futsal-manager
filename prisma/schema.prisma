
generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  ADMIN
  USER
}

enum FORMATION_TYPE {
  PRESET
  CUSTOM
}

enum POSITION {
  GOALKEEPER
  DEFENDER
  WINGER
  PIVOT
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      ROLE
  avatar    String? // S3 object key, e.g. "avatars/user-42.png" (null until upload exists)
  teamId    Int?
  team      Team?    @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String? // S3 object key, e.g. "logos/team-7.png" (null until upload exists)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players    User[]
  roster     Player[]
  formations Formation[]

  @@unique([name])
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String
  jersey    Int
  position  POSITION
  photo     String? // S3 object key, e.g. "players/player-12.png" (null until upload exists)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, jersey])
}

model Formation {
  id        Int           @id @default(autoincrement())
  teamId    Int
  type      FORMATION_TYPE
  name      String // e.g. "2-2 Diamond" (preset) or a custom label
  positions Json // [{ "x": 25, "y": 40, "position": "PIVOT" }, ...] max 5 slots
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, type, name])
}
