generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  ADMIN
  USER
}

enum POSITION {
  GOALKEEPER
  DEFENDER
  WINGER
  PIVOT
}

enum MATCH_STATUS {
  SCHEDULED
  LIVE
  FINISHED
}

enum MATCH_SIDE {
  HOME
  AWAY
}

enum MATCH_EVENT_TYPE {
  GOAL
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      ROLE
  avatar    String? // S3 object key, e.g. "avatars/user-42.png" (null until upload exists)
  teamId    Int?
  team      Team?    @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String? // S3 object key, e.g. "logos/team-7.png" (null until upload exists)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players     User[]
  roster      Player[]
  homeMatches Match[]      @relation("MatchHome")
  awayMatches Match[]      @relation("MatchAway")
  matchTeams  MatchTeam[]
  matchEvents MatchEvent[]

  @@unique([name])
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String
  jersey    Int
  position  POSITION
  photo     String? // S3 object key, e.g. "players/player-12.png" (null until upload exists)
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating    Int @default(70) // overall rating 1-99
  pace      Int @default(65)
  shooting  Int @default(65)
  passing   Int @default(65)
  defending Int @default(65)

  matchEvents MatchEvent[]

  @@unique([teamId, jersey])
}

model Match {
  id          Int          @id @default(autoincrement())
  homeTeamId  Int
  awayTeamId  Int
  scheduledAt DateTime
  venue       String?
  status      MATCH_STATUS @default(SCHEDULED)
  homeScore   Int? // denormalized; kept in sync with GOAL events
  awayScore   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  homeTeam   Team         @relation("MatchHome", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam   Team         @relation("MatchAway", fields: [awayTeamId], references: [id], onDelete: Restrict)
  matchTeams MatchTeam[]
  events     MatchEvent[]

  @@index([scheduledAt])
}

model MatchTeam {
  id          Int        @id @default(autoincrement())
  matchId     Int
  teamId      Int
  side        MATCH_SIDE
  positions   Json // FormationSlot[] snapshot. Max 7 slots (1 GK + 6 outfield)
  bench       Json   @default("[]") // MatchBenchSlot[] snapshot: [{ playerId }]; roster players not in the starting 7
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, side])
  @@unique([matchId, teamId])
}

model MatchEvent {
  id        Int              @id @default(autoincrement())
  matchId   Int
  teamId    Int
  type      MATCH_EVENT_TYPE // GOAL only for now (cards/assists later)
  minute    Int
  playerId  Int? // scorer
  createdAt DateTime         @default(now())

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([matchId])
}
